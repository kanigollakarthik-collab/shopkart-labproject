PORT=5000
MONGO_URI=mongodb+srv:......
JWT_SECRET=project
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Razorpay TEST MODE keys — never commit real values, never expose the secret to React
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# Optional
# PAYMENT_MODE=mock              # force the simulated checkout even if keys are set (dev only)
# MOCK_PAYMENT_SECRET=any_string # secret used to sign simulated payments (dev only)
# ENABLE_DEV_ENDPOINTS=true      # allow the order-status progression endpoint in production
